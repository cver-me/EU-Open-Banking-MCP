{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],

  // Worker-level Access protects every route, including workers.dev.
  // The in-code ctx.access check fails closed before that policy is attached.
  "workers_dev": true,
  "preview_urls": false,

  // Simulate the platform-provided Access context only in local development.
  "access": {
    "dev": {
      "aud": "local-development",
      "identity": { "email": "owner@example.invalid" }
    }
  },

  // Deploy buttons provision this namespace automatically. It stores Enable
  // Banking session IDs and, when TrueLayer is configured, encrypted TrueLayer
  // token records created through the protected setup flow.
  "kv_namespaces": [{ "binding": "SESSION_STORE" }],

  // No secrets are declared as required: each provider is optional and is enabled by
  // setting all of its secrets (see README). Declaring them here would make
  // `wrangler deploy` and `wrangler dev` demand secrets for providers you don't use.

  // Code logs metadata only; financial payloads and upstream bodies are never logged.
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1.0 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
